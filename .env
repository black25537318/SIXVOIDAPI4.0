# SIXVOID APIS 4.0
PORT=3000
NODE_ENV=production

# Senha forte e exclusiva do painel administrativo
ADMIN_PASSWORD= 231324251987

# WhatsApp do proprietário: país + DDD + número, somente dígitos
OWNER_WHATSAPP=55DDDNUMERO

# Instagram do proprietário, sem @
OWNER_INSTAGRAM=seu_usuario

# URL pública completa da aplicação, sem barra no final
APP_URL=https://seu-dominio.com

# SMTP para recuperação de senha (exemplo genérico)
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@dominio.com
SMTP_PASS=senha_de_app_smtp
SMTP_FROM=SIXVOID APIS <seu-email@dominio.com>

# JSON com APIs externas a monitorar. Exemplo:
# MONITORED_APIS=[{"name":"API BRAT","url":"https://exemplo.com/health"},{"name":"API TTP","url":"https://exemplo.com/status"}]
MONITORED_APIS=[]
